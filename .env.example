# Copy to .env (local) and set the same keys in Vercel project settings. Never commit real values.

# --- LLM (Google AI Studio key; free tier) ---
GEMINI_API_KEY=
# Model names are verified by `scripts/check_models.py` before use (D-011). Override here if needed.
FINN_MODEL_BULK=        # a Flash-Lite model: classification, extraction, 1-line summaries, intent parsing
FINN_MODEL_STRONG=      # a Flash model with thinking: numbers-vs-narrative, bull/bear
FINN_STRONG_THINKING_BUDGET=2048

# --- Database (Neon Postgres via Vercel Marketplace). Optional: every read falls back to snapshots. ---
DATABASE_URL=

# --- Pull background jobs (P4): fine-grained GitHub token with actions:write on this repo only ---
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=            # owner/name

# --- Optional overrides ---
FINN_DATA_DIR=          # defaults to apps/api/data
